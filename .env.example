# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never expose

# Google Places API (New) key - restrict it to the Places API
GOOGLE_PLACES_API_KEY=

# Anthropic API (email drafting + reply classification)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (sending email). FROM_EMAIL must be on a domain you verified in Resend.
RESEND_API_KEY=
FROM_EMAIL=hello@yourdomain.com

# Your deployed URL (no trailing slash) and a long random secret for signing links
APP_URL=https://your-app.vercel.app
LINK_SECRET=change-me-to-a-long-random-string

# Safety limits
DAILY_EMAIL_CAP=30
